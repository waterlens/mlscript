:llir

:import prelude.mls
//│ Imported 30 member(s)

fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

fun filter(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then h :: filter(f, t)
    else filter(f, t)

fun take(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then Nil
    else h :: take(n - 1, t)

fun dropWhile(f, ls) = if ls is
  Nil then Nil
  h :: t and
    f(h) then dropWhile(f, t)
    else h :: t

fun listEq(xs, ys) = if
  xs is Nil and ys is Nil then true
  xs is hx :: tx and ys is hy :: ty and (hx === hy) then listEq(tx, ty)
  else false

fun drop(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then ls
    else drop(n - 1, t)

fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

fun maximum(xs) = if xs is
  x :: Nil then x
  x :: xs then
    let m = maximum(xs)
    if x > m then x else m

fun nextRandStep(m, s) =
  let v = intMod(s, m) + 1
  let s_ = intMod((97 * s + 11), pow(2, 7))
  [v, s_]

fun member(x, ls) = if ls is
  Nil then false
  h :: t then (h == x) || member(x, t)

fun rev_f(ls, acc) = if ls is
  Nil then acc
  h :: t then rev_f(t, h :: acc)
fun reverse(ls) =
  rev_f(ls, Nil)

fun takeRandUnique(k, m, s) =
  fun loop(k, m, s, seen, acc) = if k == 0 then reverse(acc) else
    if nextRandStep(m, s) is [v, s_] then
      if member(v, seen) then loop(k, m, s_, seen, acc)
      else loop(k - 1, m, s_, v :: seen, v :: acc)
  loop(k, m, s, Nil, Nil)

fun simulate(n, m, proc) =
  fun lscomp(ls) = if ls is
    Nil then Nil
    seed :: t then proc(m, seed) :: lscomp(t)
  
  int_to_float(listLen(filter(x => x, lscomp(enumFromTo(1, n))))) / int_to_float(n)


fun sim(n, k) =
  fun proc(m, seed) =
    let xs = takeRandUnique(100, m, seed)
    let best = 100
    let bestk = maximum(take(k, xs))
    let afterk = dropWhile(x => x < bestk, drop(k, xs))
    listEq(best :: Nil, take(1, afterk))
  
  simulate(n, 100, proc)


fun listcomp(n, ls) = if ls is
  Nil then Nil
  h :: t then sim(n, h) :: listcomp(n, t)

fun testSecretary_nofib(n) =  
  listcomp(n, enumFromTo(35, 39))


// NOTE: original input 5000
// 50: "[0.3,0.3,0.3,0.34,0.36]"
:wholeOptFlags simp,simp2
:dumpBench secretary
:benchPrep secretary.cxx
testSecretary_nofib(2000)
