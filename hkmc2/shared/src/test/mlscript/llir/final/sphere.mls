  Ambient([0.035, 0.0325, 0.025]) ::
  Diffuse([0.5, 0.45, 0.35]) ::
  Specular([0.8, 0.8, 0.8]) ::
  Specpow(3.0) ::
  Reflect(0.5) ::
  Nil
fun testspheres() =
  let t = s2()
  Sphere([0.0, 0.0, 0.0], 0.5, t) ::
  Sphere([0.272166, 0.272166, 0.544331], 0.166667, t) ::
  Sphere([0.643951, 0.172546, 0.0], 0.166667, t) ::
