:intl
abstract class Nat: S[Nat] | O
data class S(s: Nat) extends Nat
object O extends Nat
fun odd(x) =
  if x is
    O then false
    S(s) then even(s)
fun even(x) =
  if x is
    O then true
    S(s) then odd(s)
fun foo() = odd(if 10 > 0 then S(O) else O)
fun bar() = if 10 > 0 then odd(S(O)) else odd(O)
fun main() =
  foo()
  bar()
main()
