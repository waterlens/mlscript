  head(append(lscomp(ss), ([1.0, 1.0, 1.0] :: Nil)))


data class Sphere(pos: [Num, Num, Num], radius: Num, surface: List[Surfspec])

fun spheresurf(s) = if s is Sphere(pos, rad, surf) then surf

