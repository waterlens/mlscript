fun foldr(f, z, xs) = if xs is
  Nil then z
  h :: t then f(h, foldr(f, z, t))

fun head(xs) = if xs is
  h :: _ then h

fun tail(xs) = if xs is
  _ :: t then t

fun (+:) append(xs, ys) = if xs is
  Nil then ys
  x :: xs then x :: append(xs, ys)

fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1.0, b) else Nil

fun null_(ls) = if ls is
  Nil then true
  else false

// let pi = 3.141592653589793
