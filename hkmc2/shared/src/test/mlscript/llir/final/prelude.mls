fun not(c) = if c then false else true

abstract class Option[out T]: Some[T] | None
data class Some[out T](x: T) extends Option[T]
object None extends Option

abstract class List[out T]: Cons[T] | Nil
data class (::) Cons[out T](head: T, tail: List[T]) extends List[T]
object Nil extends List

fun snd(x) = if x is [f, s] then s
fun fst(x) = if x is [f, s] then f

fun (+++) str_concat(s1, s2) = globalThis.builtin("str_concat", s1, s2)
fun str_of_int(x) = globalThis.builtin("int2str", x)
fun str_of_float(x) = globalThis.builtin("float2str", x)
fun str_head(x) = globalThis.builtin("str_head", x)
fun str_tail(x) = globalThis.builtin("str_tail", x)
fun print(x) = globalThis.builtin("println", x)
fun rand() = globalThis.builtin("rand")
fun intQuot(a, b) = globalThis.builtin("trunc_div", a, b)
fun intDiv(a, b) = globalThis.builtin("floor_div", a, b)
fun intRem(a, b) = globalThis.builtin("trunc_mod", a, b)
fun intMod(a, b) = globalThis.builtin("floor_mod", a, b)
fun quotRem(a, b) = [intQuot(a, b), intRem(a, b)]
fun divMod(a, b) = [intDiv(a, b), intMod(a, b)]
fun abs(x) = globalThis.builtin("abs", x)
fun sqrt(x) = globalThis.builtin("sqrt", x)
fun pow(x, y) = globalThis.builtin("pow", x, y)
fun tan(x) = globalThis.builtin("tan", x)
