//│         let x$1315 = t$1255.<A$1235:y> in
//│         let x$1316 = t$1255.<A$1235:z> in
//│         let x$1317 = *(x$1315,x$1316) in
//│         let x$1318 = +(x$1314,x$1317) in
//│         jump j$1313(x$1318)
