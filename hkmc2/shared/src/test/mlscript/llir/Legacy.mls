data class S(s: Nat) extends Nat
object O extends Nat
fun odd(x) =
  if x is
    O then false
    S(s) then even(s)
fun even(x) =
  if x is
    O then true
    S(s) then odd(s)
fun foo() = odd(S(S(S(O))))
