:llir

:import prelude.mls
//│ Imported 16 member(s)

abstract class Expr
data class Var(x: String) extends Expr
data class Val(n: Int) extends Expr
data class Add(e1: Expr, e2: Expr) extends Expr
data class Mul(e1: Expr, e2: Expr) extends Expr
data class Pow(e1: Expr, e2: Expr) extends Expr
data class Ln(e: Expr) extends Expr

fun pown(x, n) = if n is
  0 then 1
  1 then x
  else
    let y = pown(x, n / 2)
    y * y * (if n % 2 == 0 then 1 else x)

fun add(e1, e2) = if [e1, e2] is
  [Val(n1), Val(n2)] then Val(n1 + n2)
  [Val(0), f] then f
  [f, Val(0)] then f
  [f, Val(n)] then add(Val(n), f)
  [Val(n), Add(Val(m), f)] then add(Val(n + m), f)
  [f, Add(Val(n), g)] then add(Val(n), add(f, g))
  [Add(f, g), h] then add(f, add(g, h))
  [f, g] then Add(f, g)

fun mul(e1, e2) = if [e1, e2] is
  [Val(n1), Val(n2)] then Val(n1 * n2)
  [Val(0), _] then Val(0)
  [_, Val(0)] then Val(0)
  [Val(1), f] then f
  [f, Val(1)] then f
  [f, Val(n)] then mul(Val(n), f)
  [Val(n), Mul(Val(m), f)] then mul(Val(n * m), f)
  [f     , Mul(Val(n), g)] then mul(Val(n), mul(f, g))
  [Mul(f, g), h] then mul(f, mul(g, h))
  [f, g]      then Mul(f, g)

fun pow(e1, e2) = if [e1, e2] is
  [Val(m), Val(n)] then Val(pown(m, n))
  [f, Val(0)] then Val(1)
  [f, Val(1)] then f
  [Val(0), _] then Val(0)
  [f, g]      then Pow(f, g)

fun ln(e) = if e is
  Val(1) then Val(0)
  f then Ln(f)

fun d(x, e) = if e is
  Val(_) then Val(0)
  Var(y) then (if x == y then Val(1) else Val(0))
  Add(f, g) then add(d(x, f), d(x, g))
  Mul(f, g) then add(mul(f, d(x, g)), mul(g, d(x, f)))
  Pow(f, g) then mul(pow(f, g), add(mul(mul(g, d(x, f)), pow(f, Val(-1))), mul(ln(f), d(x, g))))
  Ln(f) then mul(d(x, f), pow(f, Val(-1)))

fun count(e) = if e is
  Val(_) then 1
  Var(_) then 1
  Add(f, g) then count(f) + count(g)
  Mul(f, g) then count(f) + count(g)
  Pow(f, g) then count(f) + count(g)
  Ln(f) then count(f)

// fun exprToString(e) = if e is
//   Val(n) then str_of_int(n)
//   Var(x) then x
//   Add(f, g) then "(" +++ exprToString(f) +++ " + " +++ exprToString(g) +++ ")"
//   Mul(f, g) then "(" +++ exprToString(f) +++ " * " +++ exprToString(g) +++ ")"
//   Pow(f, g) then "(" +++ exprToString(f) +++ " ^ " +++ exprToString(g) +++ ")"
//   Ln(f) then "ln(" +++ exprToString(f) +++ ")"

fun nestAux(s, f, n, e) = if [n, e] is
  [0, x] then x
  [m, x] then
    let r = f((s - m), x)
    nestAux(s, f, n - 1, r)

fun nest(f, n, e) = nestAux(n, f, n, e)

fun deriv(i, f) =
  let r = d("x", f)
  // print(str_of_int(i + 1) +++ " count: " +++ str_of_int(count(r)))
  r

fun main(n) =
  let x = Var("x")
  let f = pow(x, x)
  count(nest(deriv, n, f))

:showWholeOpt
:wholeOptFlags simp,split,simp2
:benchPrep deriv.cxx
main(9)
