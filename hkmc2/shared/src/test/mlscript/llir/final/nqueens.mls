:llir

:import prelude.mls
//│ Imported 30 member(s)

fun length(xs) = if xs is Cons(_, xs) then 1 + length(xs) else 0

fun safe(queen, diag, sol) =
  if sol is
    Cons(q, qs) then 
      if (queen != q) && (queen != q + diag) && (queen != q - diag)
      then true
      else safe(queen, diag + 1, qs)
    else true

fun append_safe(queen, xs, xss) =
  if queen <= 0 then xss
  else if safe(queen, 1, xs) then append_safe(queen - 1, xs, Cons(Cons(queen, xs), xss))
  else append_safe(queen, xs, xss)

fun extend(queen, acc, xss) =
  if xss is
    Cons(xs, rest) then extend(queen, append_safe(queen, xs, acc), rest)
  else acc

fun find_solution(n, queen) =
  if queen === 0 then Cons(Nil, Nil)
  else extend(n, Nil, find_solution(n, queen - 1))

fun queens(n) = length(find_solution(n, n))

:wholeOptFlags simp,simp2
:dumpBench nqueens
:benchPrep nqueens.cxx
queens(8)
