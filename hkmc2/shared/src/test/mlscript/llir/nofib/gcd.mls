:llir

abstract class List[out T]: Cons[T] | Nil
data class (::) Cons[out T](head: T, tail: List[T]) extends List[T]
object Nil extends List

object LamF1
object LamF2

fun intQuot(a, b) = globalThis.builtin("trunc_div", a, b)
fun intRem(a, b) = globalThis.builtin("trunc_mod", a, b)
fun quotRem(a, b) = [intQuot(a, b), intRem(a, b)]

fun enumFromTo(a, b) = if a <= b then a :: enumFromTo(a + 1, b) else Nil

fun g(u1u2u3, v1v2v3) = if u1u2u3 is [u1, u2, u3] and v1v2v3 is [v1, v2, v3] then
  if
    v3 == 0 then [u3, u1, u2]
    else if
      quotRem(u3, v3) is [q, r] then
        g([v1, v2, v3], [u1 - (q * v1), u2 - (q * v2), r])

fun gcdE(x, y) = if 
  x == 0 then [y, 0, 1]
  else g([1, 0, x], [0, 1, y])

fun abs(x) = globalThis.Math.abs(x)

fun max_(ls) = if ls is
  x :: Nil then x
  x :: y :: xs then if x < y then max_(y :: xs) else max_(x :: xs)

fun lscomp1(p1, ms) = if p1 is
  Nil then Nil
  h1 :: t1 then
    lscomp2(h1, t1, ms, ms)
fun lscomp2(h1, t1, p2, initMs) = if p2 is
  Nil then lscomp1(t1, initMs)
  h2 :: t2 then [h1, h2] :: lscomp2(h1, t1, t2, initMs)

fun apply(f, xs) = if f is
  LamF1 then
    if xs is [x, y] then [x, y, gcdE(x, y)]
  LamF2 then
    if xs is[d1, d2, [gg, u, v]] then abs(gg + u + v)

fun map(f, xs) = if xs is
  x :: xs then apply(f, x) :: map(f, xs)
  Nil then Nil

fun test(d) =
  let ns = enumFromTo(5000, 5000 + d)
  let ms = enumFromTo(10000, 10000 + d)
  let tripls = map(LamF1, lscomp1(ns, ms))
  let rs = map(LamF2, tripls)
  max_(rs)

fun testGcd_nofib(x) = test(x)

:wholeOpt
:wholeOptFlags simp,simp2
testGcd_nofib(1000)
