:llir

:import prelude.mls
//│ Imported 30 member(s)

fun max(a, b) = if a > b then a else b

fun take(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then Nil
    else h :: take(n - 1, t)

fun drop(n, ls) = if ls is
  Nil then Nil
  h :: t and
    n <= 0 then ls
    else drop(n - 1, t)

fun reverse(l) =
  fun r(l', l) = if l is x :: xs then r(x :: l', xs) else l'
  r(Nil, l)

fun map(f, xs) = if xs is
  x :: xs then f(x) :: map(f, xs)
  Nil then Nil

fun zip(xs, ys) = if xs is
  x :: xs and ys is y :: ys then [x, y] :: zip(xs, ys)
  else Nil

fun listLen(ls) =
  fun l(ls, a) = if ls is
    Nil then a
    h :: t then l(t, a + 1)
  l(ls, 0)

fun inList(x, ls) = if ls is
  h :: t and
    x === h then true
    else inList(x, t)
  Nil then false

fun compose(f, g)= x => f(g(x))

fun enumFromThenTo(a, t, b) = if a <= b then a :: enumFromThenTo(t, 2 * t - a, b) else Nil

fun algb2(x, k0j1, k1j1, yss) = if yss is
  Nil then Nil
  [y, k0j] :: ys then
    let kjcurr = if x == y then k0j1 + 1 else max(k1j1, k0j)
    [y, kjcurr] :: algb2(x, k0j, kjcurr, ys)

fun algb1(xss, yss) = if xss is
  Nil then map(snd, yss)
  x :: xs then algb1(xs, algb2(x, 0, 0, yss))

fun listcomp_fun(listcomp_fun_para) = if listcomp_fun_para is
    listcomp_fun_ls_h :: listcomp_fun_ls_t then [listcomp_fun_ls_h, 0] :: listcomp_fun(listcomp_fun_ls_t)
    Nil then Nil

fun algb(xs, ys) =
  0 :: algb1(xs, listcomp_fun(ys))

fun findk(k, km, m, ls) = if ls is
  Nil then km
  [x,y] :: xys then if (x + y) >= m then findk(k+1, k, x+y, xys) else findk(k+1, km, m, xys)

fun algc(m, n, xs, ys) = if
  ys is Nil then x => x
  xs is
    x :: Nil and
      inList(x, ys) then t => x :: t
      else x => x
  else
    let m2 = intDiv(m, 2)
    let xs1 = take(m2, xs)
    let xs2 = drop(m2, xs)
    let l1 = algb(xs1, ys)
    let l2 = reverse(algb(reverse(xs2), reverse(ys)))
    let k = findk(0, 0, -1, zip(l1, l2))
    compose(algc(m2, k, xs1, take(k, ys)), (algc(m-m2, n-k, xs2, drop(k, ys))))

fun lcss(xs, ys) = algc(listLen(xs), listLen(ys), xs, ys)(Nil)

fun lcssMain(a, b ,c, d, e, f) = lcss(enumFromThenTo(a,b,c), enumFromThenTo(d,e,f))

fun testLCSS_nofib() = lcssMain(1,2,4000,1000,1001,4000)

:wholeOptFlags simp,simp2
:dumpBench lcss
:benchPrep lcss.cxx
testLCSS_nofib()


