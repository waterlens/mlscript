abstract class Nat: S[Nat] | O
data class S(s: Nat) extends Nat
object O extends Nat
fun odd(x) =
  if x is
    O then false
    S(s) then even(s)
fun even(x) =
  if x is
    O then true
    S(s) then odd(s)
fun mk(n) = if n > 0 then S(mk(n - 1)) else O
fun foo() = odd(S(S(mk(10))))
foo()
