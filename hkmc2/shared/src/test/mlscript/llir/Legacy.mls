abstract class Either[out A, out B]: Left[A, B] | Right[A, B]
data class Left[out A, out B](x: A) extends Either[A, B]
data class Right[out A, out B](y: B) extends Either[A, B]
fun foo(a, b) =
  let t = if a is
    Left(x) then Left(x + 1)
    Right(y) then Right(b)
  if t is
    Left(x) then x
    Right(y) then y
fun bar() =
  foo(Right(2), 2)
bar()
