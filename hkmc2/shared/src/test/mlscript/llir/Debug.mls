:llir

:optf simp,simp2
:sopt
object Unit
fun caseA() =
  globalThis.builtin("A")
fun caseB() =
  globalThis.builtin("B")
fun caseC() =
  globalThis.builtin("C")
fun f(x, y) = 
  if x then
    if y is
      Unit then caseA()
      else caseB()
  else
    caseC()
fun g(x) = f(x, Unit)
fun main() = g(globalThis.builtin("Input"))
main()
