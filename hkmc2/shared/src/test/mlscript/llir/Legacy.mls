abstract class Nat: S[Nat] | O
data class S(s: Nat) extends Nat
object O extends Nat
fun pred(n) =
  if n is
    S(p) then p
    O then O
fun plus(n1, n2) =
  if n1 is
    O then n2
    S(p) then S(plus(p, n2))
fun fib(n) =
  if n is
    O then S(O)
    S(p) then
      if p is
        O then S(O)
        S(q) then plus(fib(p), fib(q))
fun to_int(n) =
  if n is
    O then 0
    S(p) then 1 + to_int(p)
fun to_nat(n) =
  if n == 0 then O
  else S(to_nat(n - 1))
fun main() =
  to_int(fib(to_nat(10)))
main()
